+// Cancel before RpcSocket is closed, so queries and raw streams can release
+// their references while the loop and socket remain valid.
+void HyperDHT::cancel_pending_connects() {
+    auto pending = std::move(pending_connects_);
+    for (auto& entry : pending) {
+        auto state = entry.lock();
+        if (!state || state->completed) continue;
+        state->complete(-1);
+        auto query = std::move(state->query);
+        if (query) query->destroy();
+        state->passive_timer.reset();
+        if (state->relay && state->relay->duplex) state->relay->duplex->destroy(0);
+        state->relay.reset();
+        udx::destroy_stream_once(state->raw_stream);
+        state->raw_stream = nullptr;
+    }
+}
 
