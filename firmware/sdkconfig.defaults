# Sensor client: 4MB flash, internal SRAM only. ESP-IDF 5.5.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CONFIG_SPIRAM is not set
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1536
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
# The pinned libuv adapter and libudx unconditionally use sockaddr_in6/IPPROTO_IPV6.
# Override Espruino's CONFIG_LWIP_IPV6=n; this client still uses IPv4 endpoints.
CONFIG_LWIP_IPV6=y
# CONFIG_LWIP_IPV6_AUTOCONFIG is not set
# CONFIG_LWIP_IPV6_FORWARD is not set
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
# Keep room for concurrent DHT replies and UDX traffic. The smaller 4/8/8
# Wi-Fi profile stalled UDP reception on the physical C6 during discovery.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Keep startup and driver checks active during hardware validation.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
